generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusVT {
  id          String  @id @default(cuid())
  codigo      String  @unique
  nombre      String
  frecuencias Json    @default("[]")
  activo      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  frecBoletos Frecuencia[]
  ventasBoleto VentaBoleto[]
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           String
  km             String?
  conductor      String?
  ayudanteNombre String?
  vtCode         String?
  production     Float    @default(0)
  cajaComun      Float    @default(0)
  sobrante       Float    @default(0)
  tickets        Float    @default(0)
  entregaAyudante  Float  @default(0)
  entregaCompania  Float  @default(0)
  totalGastos    Float    @default(0)
  photoUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  trips   Trip[]
  expenses Expense[]
}

model Trip {
  id           String  @id @default(cuid())
  recordId     String
  order        Int
  routeFrom    String
  routeTo      String
  time         String?
  income       Float   @default(0)
  boletos      Float   @default(0)

  record DailyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String  @id @default(cuid())
  recordId    String
  order       Int
  description String
  amount      Float   @default(0)

  record DailyRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model Persona {
  id        String   @id @default(cuid())
  nombre    String
  cedula    String?
  telefono  String?
  rol       String   @default("CONDUCTOR") // CONDUCTOR | AYUDANTE | ADMIN
  pin       String   @unique
  esActual  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── RutaGo: Módulo de Venta de Boletos Offline ───

model Frecuencia {
  id        String   @id @default(cuid())
  vtCode    String
  nombre    String
  ruta      String
  hora      String
  direccion String   // "ida" | "vuelta"
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vt     BusVT       @relation(fields: [vtCode], references: [codigo])
  ventas VentaBoleto[]
}

model VentaBoleto {
  id              String   @id @default(cuid())
  fecha           String
  vtCode          String
  frecuenciaId    String?
  ruta            String
  parada          String
  tipo            String   // "ida" | "vuelta"
  tarifaOficial   Float
  cobrado         Float
  hora            String
  ayudanteId      String
  ayudanteNombre  String
  syncStatus      String   @default("pending")
  serverId        String?
  syncError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  frecuencia Frecuencia? @relation(fields: [frecuenciaId], references: [id])
  vt         BusVT       @relation(fields: [vtCode], references: [codigo])
}
